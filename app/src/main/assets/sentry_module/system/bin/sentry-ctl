#!/system/bin/sh
# Shared Sentry CLI entry point: detect first, then dispatch to a chipset backend.
# Detection is read-only. Unknown devices never fall through to Qualcomm commands.
SCRIPT_DIR="$(dirname "$0")"
DETECTOR="$SCRIPT_DIR/chipsets/detect.sh"
[ -r "$DETECTOR" ] || {
    echo "Sentry: chipset detector missing: $DETECTOR" >&2
    exit 1
}
. "$DETECTOR"

if [ "${1:-}" = "--device-profile" ]; then
    sentry_print_profile
    exit 0
fi

CHIPSET="$(sentry_detect_chipset)"
case "$CHIPSET" in
    qualcomm)
        BACKEND="$SCRIPT_DIR/chipsets/qualcomm/sentry-ctl"
        ;;
    mediatek)
        BACKEND="$SCRIPT_DIR/chipsets/mediatek/sentry-ctl"
        ;;
    *)
        echo "Sentry: chipset could not be determined confidently; no control executed." >&2
        echo "Run sentry-ctl --device-profile for read-only detection details." >&2
        exit 2
        ;;
esac

[ -r "$BACKEND" ] || {
    echo "Sentry: selected chipset backend is missing or not executable: $BACKEND" >&2
    exit 1
}
exec sh "$BACKEND" "$@"
